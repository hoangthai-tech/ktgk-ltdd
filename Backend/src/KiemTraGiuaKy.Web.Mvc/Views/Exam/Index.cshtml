@using KiemTraGiuaKy.Web.Startup
@using KiemTraGiuaKy.Exams.Dto
@model List<ExamDto>
@{
    ViewBag.Title = "Quản lý Đề thi TOEIC Reading";
    ViewBag.CurrentPageName = PageNames.Exams;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark"><i class="fas fa-book-reader mr-2 text-primary"></i>Quản lý Đề thi TOEIC Reading</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="@Url.Action("Upload", "Exam")" class="btn btn-primary elevation-1">
                    <i class="fas fa-cloud-upload-alt mr-1"></i> Tải lên Đề thi (.docx)
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show elevation-1" role="alert">
                <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <div class="row">
            <div class="col-12">
                <div class="card card-outline card-primary elevation-2">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title font-weight-bold">
                            <i class="fas fa-list mr-2"></i> Danh sách đề thi đã nhập vào hệ thống
                        </h3>
                        <div class="card-tools">
                            <span class="badge badge-info p-2 font-weight-normal">Tổng cộng: @Model.Count đề thi</span>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (Model == null || !Model.Any())
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-folder-open text-muted fa-4x mb-3"></i>
                                <h5 class="text-muted">Chưa có đề thi nào trong cơ sở dữ liệu!</h5>
                                <p class="text-secondary">Hãy tải lên tệp tin Word (.docx) chuẩn theo định nghĩa thẻ để hệ thống tự động bóc tách và lưu trữ.</p>
                                <a href="@Url.Action("Upload", "Exam")" class="btn btn-success mt-2">
                                    <i class="fas fa-upload mr-1"></i> Bắt đầu Tải lên File Word ngay
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover table-striped table-bordered mb-0">
                                    <thead class="thead-dark text-center">
                                        <tr>
                                            <th style="width: 60px;">STT</th>
                                            <th>Mã đề</th>
                                            <th>Tên đề thi</th>
                                            <th style="width: 130px;">Số câu hỏi</th>
                                            <th style="width: 140px;">Thời gian thi</th>
                                            <th style="width: 170px;">Thời gian tạo</th>
                                            <th style="width: 250px;">Hành động</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (int i = 0; i < Model.Count; i++)
                                        {
                                            var exam = Model[i];
                                            <tr>
                                                <td class="text-center align-middle font-weight-bold">@(i + 1)</td>
                                                <td class="text-center align-middle">
                                                    <span class="badge badge-secondary px-2 py-1">@exam.Code</span>
                                                </td>
                                                <td class="align-middle">
                                                    <strong>@exam.Title</strong>
                                                    @if (!string.IsNullOrEmpty(exam.Description))
                                                    {
                                                        <br />
                                                        <small class="text-muted">@exam.Description</small>
                                                    }
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span class="badge badge-success px-2 py-1" style="font-size: 0.95rem;">
                                                        <i class="fas fa-tasks mr-1"></i> @exam.TotalQuestions câu
                                                    </span>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <span class="badge badge-info px-2 py-1" style="font-size: 0.95rem;">
                                                        <i class="fas fa-clock mr-1"></i> @exam.DurationMinutes phút
                                                    </span>
                                                </td>
                                                <td class="text-center align-middle text-muted">
                                                    <small>@exam.CreationTime.ToString("dd/MM/yyyy HH:mm")</small>
                                                </td>
                                                <td class="text-center align-middle">
                                                    <div class="btn-group" role="group">
                                                        <a href="@Url.Action("Preview", "Exam", new { id = exam.Id })" class="btn btn-sm btn-info" title="Xem trước cấu trúc đề">
                                                            <i class="fas fa-eye mr-1"></i> Xem trước
                                                        </a>
                                                        <a href="@Url.Action("Edit", "Exam", new { id = exam.Id })" class="btn btn-sm btn-warning text-dark" title="Chỉnh sửa nội dung câu hỏi">
                                                            <i class="fas fa-edit mr-1"></i> Sửa
                                                        </a>
                                                        <form asp-action="Delete" asp-controller="Exam" asp-route-id="@exam.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa toàn bộ đề thi \'@exam.Title\' cùng 100 câu hỏi liên quan?');">
                                                            <button type="submit" class="btn btn-sm btn-danger ml-1" title="Xóa đề thi">
                                                                <i class="fas fa-trash-alt mr-1"></i> Xóa
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
