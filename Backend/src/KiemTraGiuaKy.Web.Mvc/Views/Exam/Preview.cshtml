@using KiemTraGiuaKy.Web.Startup
@using KiemTraGiuaKy.Exams.Dto
@model ExamDetailDto
@{
    ViewBag.Title = "Xem trước Đề thi: " + Model.Title;
    ViewBag.CurrentPageName = PageNames.Exams;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-7">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-file-invoice text-primary mr-2"></i>Xem trước Đề thi: <strong>@Model.Title</strong>
                </h1>
            </div>
            <div class="col-sm-5 text-right">
                <a href="@Url.Action("Edit", "Exam", new { id = Model.Id })" class="btn btn-warning text-dark font-weight-bold">
                    <i class="fas fa-edit mr-1"></i> Chỉnh sửa Đề thi
                </a>
                <a href="@Url.Action("Index", "Exam")" class="btn btn-secondary ml-1">
                    <i class="fas fa-arrow-left mr-1"></i> Danh sách
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Thông tin tổng quan đề thi -->
        <div class="card card-outline card-info elevation-2 mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-3 border-right text-center">
                        <span class="text-muted d-block">Mã Đề thi</span>
                        <h4 class="font-weight-bold text-primary mb-0">@Model.Code</h4>
                    </div>
                    <div class="col-md-3 border-right text-center">
                        <span class="text-muted d-block">Tổng số câu hỏi</span>
                        <h4 class="font-weight-bold text-success mb-0">
                            <i class="fas fa-check-circle mr-1"></i>@Model.TotalQuestions câu
                        </h4>
                    </div>
                    <div class="col-md-3 border-right text-center">
                        <span class="text-muted d-block">Thời gian làm bài</span>
                        <h4 class="font-weight-bold text-info mb-0">
                            <i class="fas fa-stopwatch mr-1"></i>@Model.DurationMinutes phút
                        </h4>
                    </div>
                    <div class="col-md-3 text-center">
                        <span class="text-muted d-block">Cấu trúc đề</span>
                        <span class="badge badge-primary px-2 py-1 mr-1">Part 5 (30)</span>
                        <span class="badge badge-info px-2 py-1 mr-1">Part 6 (16)</span>
                        <span class="badge badge-secondary px-2 py-1">Part 7 (54)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs điều hướng Part 5, 6, 7 -->
        <div class="card card-primary card-tabs elevation-2">
            <div class="card-header p-0 pt-1">
                <ul class="nav nav-tabs" id="partTabs" role="tablist">
                    @foreach (var part in Model.Parts.OrderBy(p => p.PartNumber))
                    {
                        var activeClass = part.PartNumber == 5 ? "active" : "";
                        var badgeColor = part.PartNumber == 5 ? "badge-light text-primary" : (part.PartNumber == 6 ? "badge-light text-info" : "badge-light text-success");
                        <li class="nav-item">
                            <a class="nav-link @activeClass font-weight-bold" id="tab-part-@part.PartNumber" data-toggle="pill" href="#part-@part.PartNumber" role="tab">
                                <i class="fas fa-layer-group mr-1"></i> @part.Name
                                <span class="badge @badgeColor ml-2">@part.TotalQuestions câu</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="partTabsContent">
                    @foreach (var part in Model.Parts.OrderBy(p => p.PartNumber))
                    {
                        var activeClass = part.PartNumber == 5 ? "show active" : "";
                        <div class="tab-pane fade @activeClass" id="part-@part.PartNumber" role="tabpanel">
                            <div class="callout callout-info mb-4">
                                <h5><strong>@part.Name</strong> (@part.Description)</h5>
                                <p class="mb-0 text-muted">Số lượng: @part.TotalQuestions câu hỏi chuẩn TOEIC Reading.</p>
                            </div>

                            @if (part.PartNumber == 5)
                            {
                                <!-- PART 5: Các câu hỏi độc lập (Independent Questions) -->
                                <div class="row">
                                    @foreach (var q in part.IndependentQuestions.OrderBy(x => x.QuestionNumber))
                                    {
                                        <div class="col-md-6 mb-3" id="q-@q.QuestionNumber">
                                            <div class="card card-outline card-secondary h-100 shadow-sm">
                                                <div class="card-header py-2 d-flex justify-content-between align-items-center bg-light">
                                                    <span class="badge badge-primary px-2 py-1 font-weight-bold" style="font-size: 0.95rem;">
                                                        Câu @q.QuestionNumber
                                                    </span>
                                                    <span class="badge badge-success px-2 py-1">
                                                        <i class="fas fa-check mr-1"></i>Đáp án: @q.CorrectOption
                                                    </span>
                                                </div>
                                                <div class="card-body py-3">
                                                    <p class="font-weight-bold text-dark mb-3">@q.QuestionText</p>
                                                    <div class="list-group list-group-flush">
                                                        @foreach (var opt in q.Options.OrderBy(o => o.OptionLabel))
                                                        {
                                                            var isCorrect = opt.IsCorrect;
                                                            var optClass = isCorrect ? "list-group-item-success font-weight-bold" : "bg-transparent";
                                                            <div class="list-group-item py-1 px-2 @optClass border-0">
                                                                <span class="badge @(isCorrect ? "badge-success" : "badge-secondary") mr-2">@opt.OptionLabel</span>
                                                                @opt.OptionText
                                                                @if (isCorrect)
                                                                {
                                                                    <i class="fas fa-check-circle text-success float-right mt-1"></i>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- PART 6 & PART 7: Đoạn văn nhóm kèm câu hỏi con -->
                                @foreach (var group in part.Groups.OrderBy(g => g.OrderIndex))
                                {
                                    <div class="card card-outline card-secondary mb-4 shadow-sm">
                                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                            <h5 class="card-title font-weight-bold text-primary mb-0">
                                                <i class="fas fa-book-open mr-2"></i>@group.GroupTitle (Mã nhóm: @group.GroupCode)
                                            </h5>
                                            <span class="badge badge-info px-2 py-1">@group.Questions.Count câu hỏi</span>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <!-- Bài đọc đoạn văn bên trái -->
                                                <div class="col-lg-6 col-md-12 mb-3">
                                                    <div class="p-3 bg-light rounded border h-100" style="white-space: pre-wrap; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 0.95rem; line-height: 1.6; max-height: 580px; overflow-y: auto;">
                                                        <h6 class="text-uppercase text-secondary font-weight-bold border-bottom pb-2 mb-3">
                                                            <i class="fas fa-file-alt mr-1"></i> Đoạn văn bài đọc (Passage)
                                                        </h6>
                                                        @group.PassageText
                                                    </div>
                                                </div>

                                                <!-- Danh sách câu hỏi bên phải -->
                                                <div class="col-lg-6 col-md-12">
                                                    @foreach (var q in group.Questions.OrderBy(x => x.QuestionNumber))
                                                    {
                                                        <div class="card card-light mb-3 border shadow-none" id="q-@q.QuestionNumber">
                                                            <div class="card-header py-1 d-flex justify-content-between align-items-center bg-white border-bottom">
                                                                <span class="badge badge-primary px-2 py-1 font-weight-bold">
                                                                    Câu @q.QuestionNumber
                                                                </span>
                                                                <span class="badge badge-success px-2 py-1">
                                                                    <i class="fas fa-check mr-1"></i>Đáp án: @q.CorrectOption
                                                                </span>
                                                            </div>
                                                            <div class="card-body py-2">
                                                                <p class="font-weight-bold text-dark mb-2">@q.QuestionText</p>
                                                                <div class="list-group list-group-flush">
                                                                    @foreach (var opt in q.Options.OrderBy(o => o.OptionLabel))
                                                                    {
                                                                        var isCorrect = opt.IsCorrect;
                                                                        var optClass = isCorrect ? "list-group-item-success font-weight-bold" : "bg-transparent";
                                                                        <div class="list-group-item py-1 px-2 @optClass border-0">
                                                                            <span class="badge @(isCorrect ? "badge-success" : "badge-secondary") mr-2">@opt.OptionLabel</span>
                                                                            @opt.OptionText
                                                                            @if (isCorrect)
                                                                            {
                                                                                <i class="fas fa-check-circle text-success float-right mt-1"></i>
                                                                            }
                                                                        </div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
