@using KiemTraGiuaKy.Web.Startup
@using KiemTraGiuaKy.Exams.Dto
@model ExamDetailDto
@{
    ViewBag.Title = "Chỉnh sửa Đề thi: " + Model.Title;
    ViewBag.CurrentPageName = PageNames.Exams;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-7">
                <h1 class="m-0 text-dark">
                    <i class="fas fa-edit text-warning mr-2"></i>Chỉnh sửa Đề thi: <strong>@Model.Title</strong>
                </h1>
            </div>
            <div class="col-sm-5 text-right">
                <a href="@Url.Action("Preview", "Exam", new { id = Model.Id })" class="btn btn-info mr-1">
                    <i class="fas fa-eye mr-1"></i> Xem trước
                </a>
                <a href="@Url.Action("Index", "Exam")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Danh sách
                </a>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="alert alert-info elevation-1">
            <i class="fas fa-info-circle mr-2"></i> <strong>Hướng dẫn:</strong> Bấm vào nút <strong>"Sửa"</strong> ở từng câu hỏi hoặc <strong>"Sửa bài đọc này"</strong> ở từng đoạn văn để cập nhật trực tiếp nội dung. Mọi thay đổi sẽ được lưu ngay lập tức vào Cơ sở dữ liệu qua AJAX.
        </div>

        <div class="card card-warning card-outline card-tabs elevation-2">
            <div class="card-header p-0 pt-1">
                <ul class="nav nav-tabs" id="editPartTabs" role="tablist">
                    @foreach (var part in Model.Parts.OrderBy(p => p.PartNumber))
                    {
                        var activeClass = part.PartNumber == 5 ? "active" : "";
                        <li class="nav-item">
                            <a class="nav-link @activeClass font-weight-bold" id="edit-tab-part-@part.PartNumber" data-toggle="pill" href="#edit-part-@part.PartNumber" role="tab">
                                <i class="fas fa-layer-group mr-1"></i> @part.Name (@part.TotalQuestions câu)
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="editPartTabsContent">
                    @foreach (var part in Model.Parts.OrderBy(p => p.PartNumber))
                    {
                        var activeClass = part.PartNumber == 5 ? "show active" : "";
                        <div class="tab-pane fade @activeClass" id="edit-part-@part.PartNumber" role="tabpanel">
                            @if (part.PartNumber == 5)
                            {
                                <div class="row">
                                    @foreach (var q in part.IndependentQuestions.OrderBy(x => x.QuestionNumber))
                                    {
                                        var optA = q.Options.FirstOrDefault(o => o.OptionLabel == 'A')?.OptionText ?? "";
                                        var optB = q.Options.FirstOrDefault(o => o.OptionLabel == 'B')?.OptionText ?? "";
                                        var optC = q.Options.FirstOrDefault(o => o.OptionLabel == 'C')?.OptionText ?? "";
                                        var optD = q.Options.FirstOrDefault(o => o.OptionLabel == 'D')?.OptionText ?? "";

                                        <div class="col-md-6 mb-3" id="q-card-@q.Id">
                                            <div class="card card-outline card-secondary h-100 shadow-sm">
                                                <div class="card-header py-2 d-flex justify-content-between align-items-center bg-light">
                                                    <span class="badge badge-primary px-2 py-1 font-weight-bold">Câu @q.QuestionNumber</span>
                                                    <div>
                                                        <span class="badge badge-success px-2 py-1 mr-2" id="q-ans-badge-@q.Id">Đáp án: @q.CorrectOption</span>
                                                        <button type="button" class="btn btn-xs btn-warning text-dark font-weight-bold btn-edit-question"
                                                                data-id="@q.Id"
                                                                data-num="@q.QuestionNumber"
                                                                data-text="@q.QuestionText"
                                                                data-ans="@q.CorrectOption"
                                                                data-a="@optA"
                                                                data-b="@optB"
                                                                data-c="@optC"
                                                                data-d="@optD">
                                                            <i class="fas fa-pencil-alt mr-1"></i>Sửa
                                                        </button>
                                                    </div>
                                                </div>
                                                <div class="card-body py-2">
                                                    <p class="font-weight-bold mb-2" id="q-text-@q.Id">@q.QuestionText</p>
                                                    <div class="small">
                                                        <div id="q-optA-@q.Id" class="@(q.CorrectOption == 'A' ? "text-success font-weight-bold" : "")"><strong>(A)</strong> @optA</div>
                                                        <div id="q-optB-@q.Id" class="@(q.CorrectOption == 'B' ? "text-success font-weight-bold" : "")"><strong>(B)</strong> @optB</div>
                                                        <div id="q-optC-@q.Id" class="@(q.CorrectOption == 'C' ? "text-success font-weight-bold" : "")"><strong>(C)</strong> @optC</div>
                                                        <div id="q-optD-@q.Id" class="@(q.CorrectOption == 'D' ? "text-success font-weight-bold" : "")"><strong>(D)</strong> @optD</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                @foreach (var group in part.Groups.OrderBy(g => g.OrderIndex))
                                {
                                    <div class="card card-outline card-secondary mb-4 shadow-sm" id="group-card-@group.Id">
                                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                            <h5 class="card-title font-weight-bold text-primary mb-0" id="group-title-@group.Id">
                                                <i class="fas fa-book-open mr-2"></i>@group.GroupTitle (Mã: @group.GroupCode)
                                            </h5>
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-edit-passage"
                                                    data-id="@group.Id"
                                                    data-title="@group.GroupTitle">
                                                <i class="fas fa-edit mr-1"></i> Sửa bài đọc này
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-lg-6 col-md-12 mb-3">
                                                    <div class="p-3 bg-light rounded border h-100" style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6; max-height: 520px; overflow-y: auto;" id="passage-text-display-@group.Id">@group.PassageText</div>
                                                </div>
                                                <div class="col-lg-6 col-md-12">
                                                    @foreach (var q in group.Questions.OrderBy(x => x.QuestionNumber))
                                                    {
                                                        var optA = q.Options.FirstOrDefault(o => o.OptionLabel == 'A')?.OptionText ?? "";
                                                        var optB = q.Options.FirstOrDefault(o => o.OptionLabel == 'B')?.OptionText ?? "";
                                                        var optC = q.Options.FirstOrDefault(o => o.OptionLabel == 'C')?.OptionText ?? "";
                                                        var optD = q.Options.FirstOrDefault(o => o.OptionLabel == 'D')?.OptionText ?? "";

                                                        <div class="card card-light mb-3 border shadow-none" id="q-card-@q.Id">
                                                            <div class="card-header py-1 d-flex justify-content-between align-items-center bg-white border-bottom">
                                                                <span class="badge badge-primary px-2 py-1 font-weight-bold">Câu @q.QuestionNumber</span>
                                                                <div>
                                                                    <span class="badge badge-success px-2 py-1 mr-2" id="q-ans-badge-@q.Id">Đáp án: @q.CorrectOption</span>
                                                                    <button type="button" class="btn btn-xs btn-warning text-dark font-weight-bold btn-edit-question"
                                                                            data-id="@q.Id"
                                                                            data-num="@q.QuestionNumber"
                                                                            data-text="@q.QuestionText"
                                                                            data-ans="@q.CorrectOption"
                                                                            data-a="@optA"
                                                                            data-b="@optB"
                                                                            data-c="@optC"
                                                                            data-d="@optD">
                                                                        <i class="fas fa-pencil-alt mr-1"></i>Sửa
                                                                    </button>
                                                                </div>
                                                            </div>
                                                            <div class="card-body py-2">
                                                                <p class="font-weight-bold mb-2" id="q-text-@q.Id">@q.QuestionText</p>
                                                                <div class="small">
                                                                    <div id="q-optA-@q.Id" class="@(q.CorrectOption == 'A' ? "text-success font-weight-bold" : "")"><strong>(A)</strong> @optA</div>
                                                                    <div id="q-optB-@q.Id" class="@(q.CorrectOption == 'B' ? "text-success font-weight-bold" : "")"><strong>(B)</strong> @optB</div>
                                                                    <div id="q-optC-@q.Id" class="@(q.CorrectOption == 'C' ? "text-success font-weight-bold" : "")"><strong>(C)</strong> @optC</div>
                                                                    <div id="q-optD-@q.Id" class="@(q.CorrectOption == 'D' ? "text-success font-weight-bold" : "")"><strong>(D)</strong> @optD</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Chỉnh sửa Câu hỏi -->
<div class="modal fade" id="questionEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-question-circle mr-2"></i>Chỉnh sửa Câu hỏi <span id="modalQNum"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalQId" />
                <div class="form-group">
                    <label class="font-weight-bold">Nội dung câu hỏi:</label>
                    <textarea class="form-control" id="modalQText" rows="3" required></textarea>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label class="font-weight-bold text-primary">Phương án (A):</label>
                        <input type="text" class="form-control" id="modalOptA" required />
                    </div>
                    <div class="form-group col-md-6">
                        <label class="font-weight-bold text-primary">Phương án (B):</label>
                        <input type="text" class="form-control" id="modalOptB" required />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label class="font-weight-bold text-primary">Phương án (C):</label>
                        <input type="text" class="form-control" id="modalOptC" required />
                    </div>
                    <div class="form-group col-md-6">
                        <label class="font-weight-bold text-primary">Phương án (D):</label>
                        <input type="text" class="form-control" id="modalOptD" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="font-weight-bold text-success">Đáp án chính xác:</label>
                    <select class="form-control font-weight-bold" id="modalCorrectOpt">
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                        <option value="D">D</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveQuestion" onclick="saveQuestionAjax()">
                    <i class="fas fa-save mr-1"></i> Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa Đoạn văn (Passage) -->
<div class="modal fade" id="passageEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-file-alt mr-2"></i>Chỉnh sửa Bài đọc Đoạn văn</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalPassageId" />
                <div class="form-group">
                    <label class="font-weight-bold">Tiêu đề nhóm bài đọc:</label>
                    <input type="text" class="form-control" id="modalPassageTitle" required />
                </div>
                <div class="form-group">
                    <label class="font-weight-bold">Nội dung bài đọc (Đoạn văn):</label>
                    <textarea class="form-control font-monospace" id="modalPassageText" rows="14" style="line-height: 1.5; font-size: 0.95rem;"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSavePassage" onclick="savePassageAjax()">
                    <i class="fas fa-save mr-1"></i> Lưu bài đọc
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).on('click', '.btn-edit-question', function() {
            var btn = $(this);
            $('#modalQId').val(btn.data('id'));
            $('#modalQNum').text(btn.data('num'));
            $('#modalQText').val(btn.data('text'));
            $('#modalCorrectOpt').val(btn.data('ans'));
            $('#modalOptA').val(btn.data('a'));
            $('#modalOptB').val(btn.data('b'));
            $('#modalOptC').val(btn.data('c'));
            $('#modalOptD').val(btn.data('d'));
            $('#questionEditModal').modal('show');
        });

        $(document).on('click', '.btn-edit-passage', function() {
            var btn = $(this);
            var id = btn.data('id');
            var title = btn.data('title');
            var text = $('#passage-text-display-' + id).text();
            $('#modalPassageId').val(id);
            $('#modalPassageTitle').val(title);
            $('#modalPassageText').val(text);
            $('#passageEditModal').modal('show');
        });

        function saveQuestionAjax() {
            var qId = parseInt($('#modalQId').val());
            var data = {
                questionId: qId,
                questionText: $('#modalQText').val(),
                correctOption: $('#modalCorrectOpt').val(),
                optionA: $('#modalOptA').val(),
                optionB: $('#modalOptB').val(),
                optionC: $('#modalOptC').val(),
                optionD: $('#modalOptD').val()
            };

            $('#btnSaveQuestion').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang lưu...');

            fetch('@Url.Action("UpdateQuestion", "Exam")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {
                $('#btnSaveQuestion').prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu thay đổi');
                if (res.success) {
                    $('#q-text-' + qId).text(data.questionText);
                    $('#q-ans-badge-' + qId).text('Đáp án: ' + data.correctOption);

                    $('#q-optA-' + qId).html('<strong>(A)</strong> ' + data.optionA)
                        .attr('class', data.correctOption === 'A' ? 'text-success font-weight-bold' : '');
                    $('#q-optB-' + qId).html('<strong>(B)</strong> ' + data.optionB)
                        .attr('class', data.correctOption === 'B' ? 'text-success font-weight-bold' : '');
                    $('#q-optC-' + qId).html('<strong>(C)</strong> ' + data.optionC)
                        .attr('class', data.correctOption === 'C' ? 'text-success font-weight-bold' : '');
                    $('#q-optD-' + qId).html('<strong>(D)</strong> ' + data.optionD)
                        .attr('class', data.correctOption === 'D' ? 'text-success font-weight-bold' : '');

                    // Cập nhật lại data attribute trên nút sửa
                    var btn = $('button.btn-edit-question[data-id="' + qId + '"]');
                    btn.data('text', data.questionText);
                    btn.data('ans', data.correctOption);
                    btn.data('a', data.optionA);
                    btn.data('b', data.optionB);
                    btn.data('c', data.optionC);
                    btn.data('d', data.optionD);

                    $('#questionEditModal').modal('hide');
                    alert('Cập nhật câu hỏi thành công!');
                } else {
                    alert('Có lỗi xảy ra khi lưu câu hỏi.');
                }
            })
            .catch(err => {
                $('#btnSaveQuestion').prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu thay đổi');
                alert('Lỗi kết nối máy chủ: ' + err);
            });
        }

        function savePassageAjax() {
            var passageId = parseInt($('#modalPassageId').val());
            var data = {
                passageGroupId: passageId,
                groupTitle: $('#modalPassageTitle').val(),
                passageText: $('#modalPassageText').val()
            };

            $('#btnSavePassage').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang lưu...');

            fetch('@Url.Action("UpdatePassage", "Exam")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {
                $('#btnSavePassage').prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu bài đọc');
                if (res.success) {
                    $('#group-title-' + passageId).html('<i class="fas fa-book-open mr-2"></i>' + data.groupTitle);
                    $('#passage-text-display-' + passageId).text(data.passageText);

                    var btn = $('button.btn-edit-passage[data-id="' + passageId + '"]');
                    btn.data('title', data.groupTitle);

                    $('#passageEditModal').modal('hide');
                    alert('Cập nhật đoạn văn bài đọc thành công!');
                } else {
                    alert('Có lỗi xảy ra khi lưu bài đọc.');
                }
            })
            .catch(err => {
                $('#btnSavePassage').prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Lưu bài đọc');
                alert('Lỗi kết nối máy chủ: ' + err);
            });
        }
    </script>
}
